---
const year = new Date().getFullYear();

const columns: { heading: string; links: { label: string; href: string }[] }[] = [
  {
    heading: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Install', href: '/guides/install/' },
      { label: 'Guides', href: '/guides/' },
    ],
  },
  {
    heading: 'Project',
    links: [
      { label: 'GitHub', href: 'https://github.com/read-flow/read-flow' },
      { label: 'Releases', href: 'https://github.com/read-flow/read-flow/releases' },
      { label: 'License', href: 'https://github.com/read-flow/read-flow/blob/main/NOTICE' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a class="brand-link" href="/">
          <img src="/favicon-192.png" width="28" height="28" alt="" />
          <span>Read Flow</span>
        </a>
        <p>Your library, on your terms. Source available on GitHub.</p>
      </div>
      {columns.map((column) => (
        <nav aria-label={column.heading}>
          <p class="heading">{column.heading}</p>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="copyright">&copy; {year} Read Flow.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3.5rem 0 2.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .brand p {
    max-width: 22rem;
    margin-top: 0.9rem;
  }

  .heading {
    margin: 0 0 0.9rem;
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.55rem;
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  a:hover {
    color: var(--color-text);
  }

  .copyright {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
  }

  @media (min-width: 760px) {
    .top {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
