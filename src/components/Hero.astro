---
import { screenshotUrl } from '../lib/features';
import Icon from './Icon.astro';

const screenshot = screenshotUrl('cosmic-progress.png');
---
<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <p class="pill">
      <span class="dot" aria-hidden="true"></span>
      Open source · Early release
    </p>
    <h1>
      <span class="line">Your library. Your books.</span>
      <span class="line gradient-text">Your machines.</span>
    </h1>
    <p class="subhead">
      Read Flow organizes and reads your e‑book and PDF library across all your devices — locally,
      privately, and on your terms.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/guides/install/">
        Install Read Flow
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn-ghost" href="https://github.com/read-flow/read-flow">View on GitHub</a>
    </div>

    <figure class="window">
      <div class="titlebar" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <img
        src={screenshot}
        alt="The Read Flow dashboard, with documents marked unread, reading and read"
        width="1200"
        height="800"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .glow {
    position: absolute;
    left: 50%;
    top: -12rem;
    width: min(70rem, 140vw);
    height: 36rem;
    transform: translateX(-50%);
    background: var(--gradient-glow);
    filter: blur(12px);
    pointer-events: none;
  }

  .container {
    position: relative;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 0 4px rgb(52 211 153 / 0.18);
  }

  h1 {
    max-width: none;
    margin-inline: auto;
    font-size: clamp(2.6rem, 7vw, 4.9rem);
    letter-spacing: -0.035em;
  }

  .subhead {
    max-width: 38rem;
    margin: 1.5rem auto 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.25rem;
  }

  .line {
    display: block;
  }

  @media (min-width: 640px) {
    .line {
      white-space: nowrap;
    }
  }

  .window {
    position: relative;
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    max-width: 62rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-bg-2);
    box-shadow: var(--shadow-window);
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    gap: 0.45rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: rgb(8 9 53 / 0.6);
  }

  .titlebar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: rgb(238 241 251 / 0.18);
  }

  .window img {
    width: 100%;
    height: auto;
  }
</style>
