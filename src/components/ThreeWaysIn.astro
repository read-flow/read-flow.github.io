---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

const ways: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'monitor',
    title: 'Desktop app',
    body: 'A native app for Linux and macOS. Browse, read, tag, and manage scan folders from a GUI.',
  },
  {
    icon: 'server',
    title: 'Headless server',
    body: 'Run the same app without a UI on a home server or NAS, so the web app can connect over your network.',
  },
  {
    icon: 'globe',
    title: 'Web app (PWA)',
    body: 'A browser-based reader with fuzzy search and offline-capable reading, installable to any device. Can aggregate multiple Read Flow servers as sources.',
  },
];
---
<section class="three-ways section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Access</p>
      <h2>Three ways in, one library</h2>
    </div>
    <div class="cards">
      {ways.map((way) => (
        <article class="card">
          <span class="icon-tile"><Icon name={way.icon} /></span>
          <h3>{way.title}</h3>
          <p>{way.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color 200ms ease;
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  .icon-tile {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.25rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgb(56 189 248 / 0.2), rgb(168 85 247 / 0.2));
    color: var(--color-book);
  }

  h3 {
    font-size: 1.2rem;
  }

  p {
    margin-top: 0.6rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
