---
import Icon from './Icon.astro';
---
<section class="install section">
  <div class="container">
    <div class="panel">
      <div class="copy">
        <p class="eyebrow">Download</p>
        <h2>Get Read Flow</h2>
        <p>Prebuilt binaries for Linux (deb, tarball, Flatpak) and macOS (Apple Silicon).</p>
        <ul class="platforms" aria-label="Supported platforms">
          <li><Icon name="check" /> Linux x86_64 and arm64</li>
          <li><Icon name="check" /> Flatpak bundles</li>
          <li><Icon name="check" /> macOS, Apple Silicon</li>
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href="/guides/install/">
            Installation guide
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn-ghost" href="https://github.com/read-flow/read-flow/releases">
            GitHub Releases
          </a>
        </div>
      </div>
      <pre class="snippet" aria-label="Install a Debian package"><code><span class="prompt">$</span> sudo apt install ./read-flow_*.deb</code></pre>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(
        40rem 20rem at 0% 0%,
        rgb(168 85 247 / 0.22),
        transparent 70%
      ),
      var(--color-bg-2);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .copy h2 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }

  .copy > p:not(.eyebrow) {
    margin-top: 0.9rem;
    max-width: 34rem;
    color: var(--color-text-muted);
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .platforms li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .platforms :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-green);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .snippet {
    margin: 0;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgb(8 9 53 / 0.7);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    overflow-x: auto;
  }

  .prompt {
    color: var(--color-text-muted);
    user-select: none;
  }

  @media (min-width: 900px) {
    .panel {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }
  }
</style>
